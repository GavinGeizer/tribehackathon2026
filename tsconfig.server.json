{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "types": ["node"],
    "strict": true, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true
  },
  "include": ["server/**/*.ts", "frontend/src/domain/types.ts"]
}
